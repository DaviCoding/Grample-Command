{
  "name": "grample-command",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css:build": "tailwindcss -i source/styles/tailwind.css -o source/public/css/app.css --minify",
    "css:watch": "tailwindcss -i source/styles/tailwind.css -o source/public/css/app.css --watch",
    "predev": "pnpm css:build",
    "dev": "tsx watch source/server.ts",
    "prebuild": "pnpm css:build",
    "build": "tsc && tsc-alias",
    "start": "node dist/source/server.js",
    "typecheck": "tsc --noEmit",
    "hash:password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/view": "^11.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "execa": "^9.6.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.10.7",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

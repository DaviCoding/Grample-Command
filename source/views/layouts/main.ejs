<!doctype html>
<html lang="pt-BR">
  <head>
    <%- include("../partials/head", { title, csrfToken }) %>
  </head>
  <body>
    <div class="app">
      <header class="app-header">
        <a class="brand" href="/">Grample</a>

        <nav class="nav">
          <a href="/" class="<%= title === 'Dashboard' ? 'active' : '' %>">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="2" width="7" height="7" rx="2" fill="currentColor"/>
              <rect x="11" y="2" width="7" height="7" rx="2" fill="currentColor"/>
              <rect x="2" y="11" width="7" height="7" rx="2" fill="currentColor"/>
              <rect x="11" y="11" width="7" height="7" rx="2" fill="currentColor"/>
            </svg>
            Dashboard
          </a>
          <a href="/projects" class="<%= title === 'Projetos' ? 'active' : '' %>">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 5a2 2 0 012-2h3.586a1 1 0 01.707.293l1.414 1.414A1 1 0 0011.414 5H15a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V5z" fill="currentColor"/>
            </svg>
            Projetos
          </a>
          <a href="/deployments" class="<%= title === 'Deployments' ? 'active' : '' %>">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" fill="currentColor"/>
            </svg>
            Deployments
          </a>
          <a href="/execution" class="<%= title === 'Execução' ? 'active' : '' %>">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 4h12a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V5a1 1 0 011-1zm2 3v2h8V7H6zm0 4v2h5v-2H6z" fill="currentColor"/>
            </svg>
            Execução
          </a>
          <a href="/audit" class="<%= title === 'Auditoria' ? 'active' : '' %>">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 2l6 3v5c0 3.7-2.4 6.5-6 8-3.6-1.5-6-4.3-6-8V5l6-3z" fill="currentColor"/>
            </svg>
            Auditoria
          </a>
        </nav>

        <div class="header-session">
          <% if (typeof currentUser !== "undefined" && currentUser) { %>
            <form method="post" action="/sign-out" class="logout-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <span><%= currentUser.username %></span>
              <button type="submit">Sair</button>
            </form>
          <% } else { %>
            Grample Command
          <% } %>
        </div>
      </header>

      <main class="main-shell">
        <div class="page-content">
          <%- body %>
        </div>
      </main>

      <aside class="terminal-panel" id="terminal-panel">
        <div class="terminal-header">
          <div>
            <strong>Terminal</strong>
            <span id="log-status">Aguardando ação</span>
          </div>
          <button type="button" class="terminal-toggle" data-action="toggle-terminal" aria-expanded="true">
            Ocultar
          </button>
        </div>
        <pre id="deploy-log">Nenhum comando executado.</pre>
      </aside>
    </div>

    <script src="/public/js/app.js"></script>
  </body>
</html>

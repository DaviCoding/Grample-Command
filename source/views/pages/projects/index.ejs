<%- include("../../layouts/main", {
  title,
  csrfToken,
  currentUser,
  body: `
    <section class="intro compact">
      <span class="eyebrow">Configuracao</span>
      <h1>Projetos</h1>
      <p>O Command e o bootstrapper tecnico da Grample: cadastra projetos, guarda os .env no vault local, clona, valida Docker Compose e sobe os servicos na ordem correta.</p>
      <div class="actions">
        <button type="button" class="button primary" data-action="bootstrap-grample">
          Inicializar Grample
        </button>
      </div>
    </section>

    <section class="repos">
      ${projects.map((project) => `
        <article class="repo-card">
          <div class="repo-info">
            <div>
              <strong>${project.name}</strong>
              <span>${project.repository}</span>
              <span>${project.path}</span>
            </div>

            <span class="status ${project.status}">${project.status}</span>
          </div>

          <div class="commits">
            <div>
              <small>Branch</small>
              <code>${project.branch}</code>
            </div>

            <div>
              <small>Compose</small>
              <code>${project.composeFile}</code>
            </div>

            <div>
              <small>.env no projeto</small>
              <span class="status ${project.envExists ? "initialized" : "pending"}">${project.envExists ? "criado" : "pendente"}</span>
            </div>

            <div>
              <small>.env no vault</small>
              <span class="status ${project.storedEnvExists ? "initialized" : "pending"}">${project.storedEnvExists ? "guardado" : "pendente"}</span>
            </div>
          </div>

          <div class="actions">
            ${!project.storedEnvExists ? `
              <button type="button" class="button secondary" data-action="open-env-editor" data-project-id="${project.id}" data-project-name="${project.name}">
                Criar .env no vault
              </button>
            ` : ""}

            ${project.exists && project.envExists && !project.storedEnvExists ? `
              <button type="button" class="button secondary" data-action="adopt-env" data-project-id="${project.id}">
                Adotar .env existente
              </button>
            ` : ""}

            ${project.storedEnvExists ? `
              <button type="button" class="button secondary" disabled>
                .env guardado
              </button>
            ` : ""}
          </div>
        </article>
      `).join("")}
    </section>

    <section class="env-modal hidden" data-env-modal aria-hidden="true">
      <div class="env-modal-backdrop" data-action="close-env-editor"></div>
      <div class="env-modal-panel" role="dialog" aria-modal="true" aria-labelledby="env-modal-title">
        <header class="env-modal-header">
          <div>
            <small>Arquivo de ambiente</small>
            <h2 id="env-modal-title">Criar .env</h2>
            <p data-env-project-name>Escreva o conteudo uma unica vez. O Command guarda no vault e aplica no projeto antes de subir.</p>
          </div>
          <button type="button" class="button secondary" data-action="close-env-editor">Fechar</button>
        </header>

        <div id="env-editor" class="env-editor"></div>

        <footer class="env-modal-footer">
          <p>Operacao sensivel: o arquivo sera criado com permissao restrita e falhara se ja existir.</p>
          <button type="button" class="button primary" data-action="create-env">Criar .env no vault</button>
        </footer>
      </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.js"></script>
  `
}) %>

NODE_ENV=development
APP_NAME=Grample Command
APP_HOST=0.0.0.0
APP_PORT=3333
COMMAND_ADMIN_USERNAME=admin
COMMAND_ADMIN_PASSWORD_HASH=
COMMAND_SESSION_SECRET=
COMMAND_SESSION_TTL_SECONDS=28800
COMMAND_COOKIE_SECURE=false

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900

# Linux server:
PROJECTS_BASE_PATH=/apps
PROJECTS_HOST_PATH=/apps
PROJECTS_NETWORK_NAME=grample_net
PROJECT_ENVS_PATH=source/storage/envs

# Windows example:
# PROJECTS_BASE_PATH=C:/Users/Davi Alves/Documents/CODE
# PROJECTS_HOST_PATH=C:/Users/Davi Alves/Documents/CODE

# GitHub fine-grained token for private repositories.
GITHUB_TOKEN=

# Optional: used only when project.databaseUrlEnv points to DATABASE_URL.
DATABASE_URL=

# Backup directory.
BACKUP_DIR=/opt/command/backups
BACKUPS_HOST_PATH=/opt/command/backups
